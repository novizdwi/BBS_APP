<div style="padding:10px;">
    <div style="display:flex; gap:6px; margin-bottom:10px;">
        <input id="notifSearch"
               style="flex:1; padding:6px;"
               placeholder="Cari No Transaction..." />

        <button type="button"
                onclick="notifDoSearch()"
                style="padding:6px 10px;">
            Search
        </button>
    </div>

    <div id="notifGridArea">
        @Html.Action("Grid", "Notification")
    </div>
</div>

<script>

    function notifDoSearch() {
        var v = (document.getElementById('notifSearch').value || '').trim();
        gvNotif.PerformCallback({ search: v });
    }

</script>
